# ============================================================
# Incidentra Backend — Local Development
# Copy to .env: cp .env.example .env
# Docker: use backend/.env.docker.example instead
# ============================================================

FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Demo SOC users (seeded on startup, password stored hashed)
# SYNC_DEMO_CREDENTIALS=1 refreshes admin/analyst passwords on each start.
# Set a strong password here, or leave blank for a random password generated
# on first seed (printed ONCE to the startup log, never stored in plaintext).
SYNC_DEMO_CREDENTIALS=1
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=

# CORS — set to your frontend URL in production
# CORS_ORIGINS=https://your-app.vercel.app

# PostgreSQL & Redis (localhost)
DATABASE_URL=postgresql://incidentra:incidentra123@localhost:5432/incidentra_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI incident explanations (optional — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# IP threat intelligence (optional)
ABUSEIPDB_API_KEY=

# Log monitor — first run: simulated; after vuln-web up: switch to false + paths below
USE_SIMULATED_LOGS=true
DEMO_MODE=true
SIMULATED_LOG_DELAY=5
WEB_SERVER_LOG_PATH=../vuln-web/logs/access.log
LOG_MONITOR_INTERVAL=1
BLOCKED_IPS_JSON_PATH=../vuln-web/logs/blocked_ips.json
RATE_LIMITED_JSON_PATH=../vuln-web/logs/rate_limited.json

# Automated response thresholds
TEMP_BLOCK_DURATION=86400
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=10
BRUTE_FORCE_THRESHOLD=10

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
ADMIN_CONTACT_EMAIL=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
